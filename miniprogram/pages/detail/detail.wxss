.page {
  padding-bottom: 40rpx;
}
.summary {
  padding-bottom: 8rpx;
}
.s-title {
  font-size: 34rpx;
  font-weight: 700;
}
.s-sub {
  color: #909399;
  font-size: 22rpx;
  margin-top: 10rpx;
}
.s-stats {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 40rpx;
  margin-top: 26rpx;
}
.stat {
  text-align: center;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 700;
}
.stat-label {
  color: #909399;
  font-size: 21rpx;
  margin-top: 6rpx;
}
.bigtag {
  font-size: 28rpx;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
}
.tag-pass {
  background: #f0f9eb;
  color: #67c23a;
}
.tag-fail {
  background: #fef0f0;
  color: #f56c6c;
}
.tag-warn {
  background: #fdf6ec;
  color: #e6a23c;
}
.warn {
  margin-top: 20rpx;
  background: #fdf6ec;
  color: #e6a23c;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
}
.sec-name {
  font-size: 30rpx;
  font-weight: 700;
  border-left: 6rpx solid #1c3faa;
  padding-left: 14rpx;
  margin: 30rpx 24rpx 14rpx;
}
.q {
  margin: 14rpx 24rpx;
}
.q-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}
.q-no {
  font-weight: 700;
}
.q-score {
  margin-left: auto;
  font-size: 24rpx;
}
.tag {
  background: #f0f2f5;
  color: #606266;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  font-size: 21rpx;
}
.tag.score {
  background: #fdf6ec;
  color: #e6a23c;
}
.stem {
  white-space: pre-wrap;
  line-height: 1.8;
  background: #f8f9fb;
  border-left: 6rpx solid #1c3faa;
  padding: 16rpx 18rpx;
  border-radius: 6rpx;
  margin: 18rpx 0;
  font-size: 26rpx;
}
.opt {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #ebeef5;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.opt-answer {
  border-color: #67c23a;
  background: #f0f9eb;
}
.opt-wrong {
  border-color: #f56c6c;
  background: #fef0f0;
}
.letter {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid #c0c4cc;
  text-align: center;
  line-height: 38rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}
.opt-text {
  flex: 1;
}
.answer-line {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.8;
}
.sep {
  color: #dcdfe6;
  margin: 0 8rpx;
}
.pass {
  color: #67c23a;
  font-weight: 700;
}
.partial {
  color: #e6a23c;
  font-weight: 700;
}
.fail {
  color: #f56c6c;
  font-weight: 700;
}
.muted {
  color: #909399;
}
.rc-tag {
  font-size: 21rpx;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-left: 10rpx;
}
.my-text,
.ref-text {
  white-space: pre-wrap;
  background: #f8f9fb;
  border-radius: 8rpx;
  padding: 16rpx 18rpx;
  line-height: 1.8;
  font-size: 25rpx;
  margin-top: 10rpx;
}
.ref-text {
  background: #f0f9eb;
}
.self {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 25rpx;
}
.self-input {
  width: 160rpx;
  background: #f5f7fa;
  border: 1rpx solid #dcdfe6;
  border-radius: 6rpx;
  padding: 10rpx 14rpx;
  text-align: center;
}
.self-btn {
  margin: 0;
  background: #1c3faa;
  color: #fff;
  font-size: 24rpx;
}
.analysis {
  margin-top: 16rpx;
  color: #909399;
  font-size: 23rpx;
  border-top: 1rpx dashed #ebeef5;
  padding-top: 14rpx;
  white-space: pre-wrap;
}
.loading {
  text-align: center;
  color: #909399;
  padding: 80rpx 0;
}
.bottom-space {
  height: 40rpx;
}
