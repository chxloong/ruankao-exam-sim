<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">旧密码</text>
      <input class="input" password value="{{oldPassword}}" bindinput="onOld" placeholder="请输入当前密码" />
    </view>
    <view class="field">
      <text class="label">新密码</text>
      <input class="input" password value="{{newPassword}}" bindinput="onNew" placeholder="至少 6 位" />
    </view>
    <view class="field">
      <text class="label">确认新密码</text>
      <input class="input" password value="{{confirm}}" bindinput="onConfirm" placeholder="再次输入新密码" />
    </view>
    <button class="btn-primary login-btn" loading="{{loading}}" bindtap="doChange">保存新密码</button>
    <view class="hint">修改成功后需使用新密码重新登录</view>
  </view>
</view>
